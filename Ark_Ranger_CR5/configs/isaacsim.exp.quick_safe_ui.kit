[package]
description = "Quick-safe minimal UI experience without RTX hydra/material library."
title = "Isaac Sim Quick Safe UI"
version = "5.1.0"

[dependencies]
"isaacsim.simulation_app" = {}
"isaacsim.core.api" = {}
"isaacsim.core.utils" = {}
"isaacsim.core.simulation_manager" = {}
"isaacsim.storage.native" = {}
"omni.isaac.core_archive" = {}
"omni.isaac.ml_archive" = {}
"omni.isaac.core" = {}
"omni.isaac.kit" = {}
"omni.isaac.motion_generation" = {}
"omni.isaac.lula" = {}
"omni.kit.loop-isaac" = {}
"omni.kit.stage_templates" = {}
"omni.kit.usd.layers" = {}
"omni.physics.physx" = {}
"omni.physics.stageupdate" = {}
"omni.usd" = {}
"omni.usd.core" = {}
"omni.usd.schema.semantics" = {}
"omni.warp.core" = {}
"omni.pip.cloud" = {}
"omni.pip.compute" = {}
"omni.hydra.usdrt_delegate" = {}
"omni.kit.mainwindow" = {}
"omni.kit.viewport.window" = {}

[settings.app]
name = "Isaac-Sim Quick Safe UI"
version = "5.1.0"
settings.persistent = false
window.title = "Isaac Sim Quick Safe UI"
vulkan = true
enableDeveloperWarnings = false

[settings.app.exts.folders]
'++' = [
    "${app}",
    "${app}/../exts",
    "${app}/../extscache",
    "${app}/../extsUser",
    "${app}/../extsDeprecated",
]

[settings.exts."omni.kit.mainwindow"]
startup.dockWindows = false

[settings.exts."omni.kit.viewport.window"]
startup.disableWindowOnLoad = false
startup.dockTabInvisible = false
